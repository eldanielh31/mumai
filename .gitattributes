# CSV exportados: conservar bytes CRLF originales para verificar SHA-256 tras clonar.
*.csv -text whitespace=cr-at-eol

# Videos de entrada autorizados; binarios almacenados con Git LFS.
data/input/**/*.avi filter=lfs diff=lfs merge=lfs -text
data/input/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
data/input/**/*.mov filter=lfs diff=lfs merge=lfs -text
data/input/**/*.mkv filter=lfs diff=lfs merge=lfs -text
data/input/**/*.m4v filter=lfs diff=lfs merge=lfs -text
data/input/**/*.webm filter=lfs diff=lfs merge=lfs -text
